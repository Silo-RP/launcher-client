<section id="loginOptionsContainer" class="view" style="display: none;" aria-label="<%- lang('loginOptions.loginOptionsTitle') %>">
    <div class="login">
        <img class="emblem" src="./assets/images/emblem.png" width="64" height="64" alt="" aria-hidden="true">
        <h1 class="title"><%- lang('loginOptions.title') %></h1>
        <p class="loginLead"><%- lang('loginOptions.lead') %></p>
        <button id="loginOptionMicrosoft" class="play loginPlay" type="button"><%- lang('loginOptions.loginWithMicrosoft') %></button>
        <p class="small loginNote"><%- lang('loginOptions.note') %></p>
        <div id="loginOptionCancelContainer" style="display: none;">
            <button id="loginOptionCancelButton" class="linkbtn" type="button"><%- lang('loginOptions.cancelButton') %></button>
        </div>
    </div>
    <script src="./assets/js/scripts/loginOptions.js"></script>
</section>
