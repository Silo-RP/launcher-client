<section id="landingContainer" class="view" style="display: none;" data-mode="accueil" aria-label="<%- lang('frame.navHome') %>">
    <div class="bottom">
        <div class="col">
            <button class="teaser onlyHome" id="newsTeaser" type="button" hidden>
                <span class="teaserDot" aria-hidden="true"></span>
                <span class="muted" id="newsTeaserNum"></span>
                <span class="teaserTitle" id="newsTeaserTitle"></span>
                <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true" class="muted"><path d="M2 6h8M6.5 2.5 10 6l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <p class="small pacte onlyLaunch"><%- lang('landing.pacte') %></p>
            <div>
                <h1 class="title" id="landingTitle"><%- lang('landing.title') %></h1>
                <p class="tagline onlyHome" id="landingTagline"><%- lang('landing.tagline') %></p>
            </div>
            <p class="status onlyHome" id="server_status_wrapper">
                <span class="dot" id="serverStatusDot" aria-hidden="true"></span>
                <span class="strong" id="landingPlayerLabel"><%- lang('landing.serverStatusLoading') %></span>
                <span class="statusPart" id="player_count" hidden></span>
                <span class="statusPart" id="landingVersion" hidden></span>
            </p>
            <div class="launchBlock onlyLaunch" id="launch_details">
                <div class="row">
                    <span id="launch_details_text" role="status"><%- lang('landing.launchDetails') %></span>
                    <span class="level" id="launch_level"></span>
                </div>
                <div class="track" id="launch_progress" role="progressbar" aria-label="<%- lang('landing.progressLabel') %>" aria-valuemin="0" aria-valuemax="144" aria-valuenow="0"><div class="fill" id="launch_fill"></div></div>
                <div class="row rowSmall">
                    <span class="muted ellipsis" id="launch_progress_label"></span>
                    <button class="linkbtn" id="launch_log_toggle" type="button" aria-expanded="false" aria-controls="launch_log"><%- lang('landing.showLog') %></button>
                </div>
            </div>
        </div>
        <div class="side">
            <div id="launch_content" class="onlyHome">
                <button class="play" id="launch_button" type="button" disabled><%- lang('landing.launchButton') %></button>
            </div>
            <button class="ghost onlyLaunch" id="launch_state" type="button" disabled><%- lang('landing.launchStatePreparing') %></button>
            <span class="small" id="landingMeta"></span>
        </div>
    </div>
    <div class="log onlyLaunch" id="launch_log" role="log" aria-label="<%- lang('landing.logLabel') %>" hidden></div>
    <script src="./assets/js/scripts/landing.js"></script>
</section>
