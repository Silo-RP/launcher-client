<section id="newsContainer" class="view" style="display: none;" aria-label="<%- lang('frame.navBulletin') %>">
    <nav class="posts" aria-label="<%- lang('news.listLabel') %>">
        <p class="small postsTitle"><%- lang('news.listTitle') %></p>
        <div id="newsList"></div>
    </nav>
    <article class="article" id="newsArticle" tabindex="-1"></article>
    <div class="newsEmpty" id="newsEmpty" hidden>
        <h2><%- lang('news.emptyTitle') %></h2>
        <p class="muted"><%- lang('news.emptyText') %></p>
    </div>
    <script src="./assets/js/scripts/news.js"></script>
</section>
