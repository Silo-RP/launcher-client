<section id="settingsContainer" class="view" style="display: none;" aria-label="<%- lang('settings.navHeaderText') %>">
    <aside class="drawer" aria-labelledby="settingsTitle">
        <header>
            <h2 id="settingsTitle"><%- lang('settings.navHeaderText') %></h2>
            <button class="wc drawerClose" id="settingsNavDone" type="button" aria-label="<%- lang('settings.navDone') %>"><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 2.5l7 7M9.5 2.5l-7 7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg></button>
        </header>
        <div class="body" id="settingsBody">

            <div class="field">
                <div class="row"><span class="lbl" id="settingsMemoryTitle"><%- lang('settings.memoryTitle') %></span><span class="val" id="settingsMaxRAMLabel">3 Go</span></div>
                <div id="settingsMaxRAMRange" class="rangeSlider" cValue="MaxRAM" serverDependent min="3" max="8" value="3" step="0.5" role="slider" aria-labelledby="settingsMemoryTitle">
                    <div class="rangeSliderBar"></div>
                    <div class="rangeSliderTrack"></div>
                </div>
                <span class="small"><%- lang('settings.memorySystem') %> <span id="settingsMemoryTotal">-</span>, <span id="settingsMemoryAvail">-</span> <%- lang('settings.memoryFree') %></span>
            </div>

            <div class="field">
                <span class="lbl" id="settingsResolutionTitle"><%- lang('settings.gameResolutionTitle') %></span>
                <div class="resRow">
                    <input type="number" id="settingsGameWidth" min="0" cValue="GameWidth" aria-label="<%- lang('settings.gameWidth') %>">
                    <span class="muted" aria-hidden="true">&times;</span>
                    <input type="number" id="settingsGameHeight" min="0" cValue="GameHeight" aria-label="<%- lang('settings.gameHeight') %>">
                    <label class="toggleSwitch inlineCheck">
                        <input type="checkbox" cValue="Fullscreen">
                        <span class="toggleSwitchSlider" aria-hidden="true"></span>
                        <span><%- lang('settings.launchFullscreenTitle') %></span>
                    </label>
                </div>
            </div>

            <div class="field inline">
                <div class="stack"><span class="lbl"><%- lang('settings.javaTitle') %></span><span class="small"><%- lang('settings.javaDesc') %></span></div>
            </div>

            <div class="field">
                <span class="lbl" id="settingsDataDirTitle"><%- lang('settings.dataDirectoryTitle') %></span>
                <div class="pathRow">
                    <input class="settingsFileSelVal mono" type="text" value="" cValue="DataDirectory" disabled aria-labelledby="settingsDataDirTitle">
                    <button class="linkbtn settingsFileSelButton" type="button" dialogTitle="<%- lang('settings.selectDataDirectory') %>" dialogDirectory="true"><%- lang('settings.chooseFolder') %></button>
                    <button class="linkbtn" id="settingsOpenDataDir" type="button"><%- lang('settings.openFolder') %></button>
                </div>
            </div>

            <label class="field inline toggleSwitch">
                <span class="lbl"><%- lang('settings.animatedBackgroundTitle') %></span>
                <input type="checkbox" cValue="AnimatedBackground" id="settingsAnimatedBackground">
                <span class="toggleSwitchSlider" aria-hidden="true"></span>
            </label>

            <label class="field inline toggleSwitch">
                <span class="stack"><span class="lbl"><%- lang('settings.minimizeOnLaunchTitle') %></span><span class="small"><%- lang('settings.minimizeOnLaunchDesc') %></span></span>
                <input type="checkbox" cValue="MinimizeOnLaunch">
                <span class="toggleSwitchSlider" aria-hidden="true"></span>
            </label>

            <div class="field addonsField" id="settingsAddonsContainer">
                <span class="lbl"><%- lang('settings.tabAddonsHeaderText') %></span>
                <span class="small"><%- lang('settings.tabAddonsHeaderDesc') %></span>
                <div id="settingsAddonsContent"></div>
            </div>

            <details class="advanced" id="settingsAdvanced">
                <summary><%- lang('settings.advancedTitle') %></summary>

                <div class="field">
                    <div class="row"><span class="lbl" id="settingsMinRAMTitle"><%- lang('settings.minRAM') %></span><span class="valPlain" id="settingsMinRAMLabel">3 Go</span></div>
                    <div id="settingsMinRAMRange" class="rangeSlider" cValue="MinRAM" serverDependent min="3" max="8" value="3" step="0.5" role="slider" aria-labelledby="settingsMinRAMTitle">
                        <div class="rangeSliderBar"></div>
                        <div class="rangeSliderTrack"></div>
                    </div>
                    <span class="small"><%- lang('settings.memoryDesc') %></span>
                </div>

                <div class="field">
                    <label class="lbl" for="settingsJVMOptsVal"><%- lang('settings.jvmOptsTitle') %></label>
                    <input id="settingsJVMOptsVal" class="mono" cValue="JVMOptions" serverDependent type="text">
                    <span class="small"><%- lang('settings.jvmOptsDesc') %> <a href="#" id="settingsJvmOptsLink"><!-- Available Options --></a></span>
                </div>

                <label class="field inline toggleSwitch">
                    <span class="stack"><span class="lbl"><%- lang('settings.launchDetachedTitle') %></span><span class="small"><%- lang('settings.launchDetachedDesc') %></span></span>
                    <input type="checkbox" cValue="LaunchDetached">
                    <span class="toggleSwitchSlider" aria-hidden="true"></span>
                </label>

                <label class="field inline toggleSwitch">
                    <span class="stack"><span class="lbl"><%- lang('settings.allowPrereleaseTitle') %></span><span class="small"><%- lang('settings.allowPrereleaseDesc') %></span></span>
                    <input type="checkbox" cValue="AllowPrerelease">
                    <span class="toggleSwitchSlider" aria-hidden="true"></span>
                </label>

                <div class="field" id="settingsTabUpdate">
                    <div class="row">
                        <span class="lbl" id="settingsUpdateTitle"><!-- You Are Running the Latest Version --></span>
                        <span class="small"><span id="settingsUpdateVersionCheck" aria-hidden="true"></span><span id="settingsUpdateVersionTitle"><%- lang('settings.stableRelease') %></span> <span id="settingsUpdateVersionValue"></span></span>
                    </div>
                    <div class="settingsChangelogContainer" style="display: none;">
                        <span class="lbl settingsChangelogTitle"></span>
                        <div class="small settingsChangelogText"></div>
                    </div>
                    <button class="secondary" id="settingsUpdateActionButton" type="button"><%- lang('settings.checkForUpdates') %></button>
                </div>

                <div class="field inline">
                    <span class="stack"><span class="lbl"><%- lang('settings.repairTitle') %></span><span class="small"><%- lang('settings.repairDesc') %></span></span>
                    <button class="secondary" id="settingsRepairButton" type="button"><%- lang('settings.repairButton') %></button>
                </div>

                <div class="field inline">
                    <span class="lbl"><%- lang('settings.devToolsConsole') %></span>
                    <button class="linkbtn" id="settingsAboutDevToolsButton" type="button"><%- lang('settings.open') %></button>
                </div>
            </details>
        </div>
        <footer>
            <span><%- lang('app.title') %> <span id="settingsAboutCurrentVersionValue"></span></span>
            <% const youtubeURL = lang('landing.mediaYouTubeURL'), discordURL = lang('landing.mediaDiscordURL') %>
            <% if (youtubeURL || discordURL) { %>
            <span class="footerLinks">
                <% if (discordURL) { %><a href="<%- discordURL %>">Discord</a><% } %>
                <% if (youtubeURL) { %><a href="<%- youtubeURL %>">YouTube</a><% } %>
            </span>
            <% } %>
        </footer>
    </aside>
    <script src="./assets/js/scripts/settings.js"></script>
</section>
