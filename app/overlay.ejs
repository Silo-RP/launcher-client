<div id="overlayContainer" style="display: none;">
    <div id="serverSelectContent" class="dialog" role="dialog" aria-labelledby="serverSelectHeader" style="display: none;">
        <h2 id="serverSelectHeader"><%- lang('overlay.serverSelectHeader') %></h2>
        <div id="serverSelectList">
            <div id="serverSelectListScrollable">
                <!-- Server listings populated here. -->
            </div>
        </div>
        <div class="dialogActions">
            <button id="serverSelectCancel" class="ghost small overlayKeybindEsc" type="button"><%- lang('overlay.serverSelectCancel') %></button>
            <button id="serverSelectConfirm" class="primary overlayKeybindEnter" type="submit"><%- lang('overlay.serverSelectConfirm') %></button>
        </div>
    </div>
    <div id="accountSelectContent" class="dialog" role="dialog" aria-labelledby="accountSelectHeader" style="display: none;">
        <h2 id="accountSelectHeader"><%- lang('overlay.accountSelectHeader') %></h2>
        <div id="accountSelectList">
            <div id="accountSelectListScrollable">
                <!-- Accounts populated here. -->
            </div>
        </div>
        <div class="dialogActions">
            <button id="accountSelectCancel" class="ghost small overlayKeybindEsc" type="button"><%- lang('overlay.accountSelectCancel') %></button>
            <button id="accountSelectConfirm" class="primary overlayKeybindEnter" type="submit"><%- lang('overlay.accountSelectConfirm') %></button>
        </div>
    </div>
    <div id="overlayContent" class="dialog" role="alertdialog" aria-labelledby="overlayTitle" aria-describedby="overlayDesc">
        <h2 id="overlayTitle"></h2>
        <div id="overlayDesc"></div>
        <div class="dialogActions" id="overlayActionContainer">
            <button id="overlayDismiss" style="display: none;" class="ghost small overlayKeybindEsc" type="button"></button>
            <button id="overlayAcknowledge" class="primary overlayKeybindEnter" type="button"></button>
        </div>
    </div>
    <script src="./assets/js/scripts/overlay.js"></script>
</div>
