<header id="frameBar" class="topbar">
    <nav class="nav" aria-label="<%- lang('frame.navLabel') %>">
        <svg class="emblem" width="20" height="20" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="none" stroke="currentColor" stroke-opacity="0.7" stroke-width="1.2"/><circle cx="10" cy="10" r="5.2" fill="none" stroke="currentColor" stroke-opacity="0.7" stroke-width="1.2"/><circle cx="10" cy="10" r="1.7" fill="#E3A341"/></svg>
        <button class="navLink" type="button" data-nav="accueil"><%- lang('frame.navHome') %></button>
        <button class="navLink" type="button" data-nav="bulletin"><%- lang('frame.navBulletin') %></button>
        <button class="navLink" type="button" data-nav="parametres"><%- lang('frame.navSettings') %></button>
    </nav>
    <div class="win">
        <button class="updateChip" id="updateAvailableButton" type="button" hidden><%- lang('frame.updateAvailable') %></button>
        <div class="accountWrap">
            <button class="chip" id="accountChip" type="button" aria-haspopup="true" aria-expanded="false" aria-controls="accountMenu">
                <span class="avatar" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 16 16"><circle cx="8" cy="5.5" r="3" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M2.5 14c.8-2.8 3-4.2 5.5-4.2s4.7 1.4 5.5 4.2" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg></span>
                <span id="user_text"><%- lang('landing.usernamePlaceholder') %></span>
            </button>
            <div class="accountMenu" id="accountMenu" hidden>
                <p class="menuTitle"><%- lang('frame.accountsTitle') %></p>
                <div class="settingsCurrentAccounts" id="settingsCurrentMicrosoftAccounts">
                    <!-- Microsoft auth accounts populated here (settings.js). -->
                </div>
                <button class="menuAction" id="settingsAddMicrosoftAccount" type="button"><%- lang('settings.addMicrosoftAccount') %></button>
            </div>
        </div>
        <span class="sep" aria-hidden="true"></span>
        <button class="wc fMb" id="frameButton_minimize" type="button" tabindex="-1" aria-label="<%- lang('frame.minimize') %>"><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 6h8" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg></button>
        <button class="wc wcClose fCb" id="frameButton_close" type="button" tabindex="-1" aria-label="<%- lang('frame.close') %>"><svg width="12" height="12" viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 2.5l7 7M9.5 2.5l-7 7" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/></svg></button>
    </div>
</header>
<div class="banner" id="siloBanner" role="alert" hidden></div>
