<html lang="fr" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <meta charset="utf-8" http-equiv="Content-Security-Policy" content="script-src 'self' 'sha256-In6B8teKZQll5heMl9bS7CESTbGvuAt3VVV86BUQBDk='"/>
    <title><%= lang('app.title') %></title>
    <link type="text/css" rel="stylesheet" href="./assets/css/silo/tokens.css">
    <link type="text/css" rel="stylesheet" href="./assets/css/silo/app.css">
    <script src="./assets/js/remote-shim.js"></script>
    <script src="./assets/js/silo/silo-ps1.js"></script>
    <script src="./assets/js/silo/silo-background.js"></script>
    <script src="./assets/js/scripts/uicore.js"></script>
    <script src="./assets/js/scripts/uibinder.js"></script>
    <script src="./assets/js/scripts/siloui.js"></script>
</head>
<body data-screen="chargement">
    <!-- Single 3D background, mounted once behind the whole UI (see siloui.js). -->
    <div id="bg" aria-hidden="true"></div>
    <div id="shade" aria-hidden="true"></div>
    <!-- Before #main: settings.js and landing.js grab the account menu and
         the account name from the top bar when they load. -->
    <%- include('frame') %>
    <div id="main">
        <%- include('login') %>
        <%- include('waiting') %>
        <%- include('loginOptions') %>
        <%- include('settings') %>
        <%- include('news') %>
        <%- include('landing') %>
    </div>
    <!-- Shown while Minecraft runs: static, the 3D background is unmounted meanwhile (siloui.js). -->
    <section id="gameRunning" aria-live="polite" aria-labelledby="gameRunningTitle">
        <svg class="emblem" width="40" height="40" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="none" stroke="currentColor" stroke-opacity="0.7" stroke-width="0.8"/><circle cx="10" cy="10" r="5.2" fill="none" stroke="currentColor" stroke-opacity="0.7" stroke-width="0.8"/><circle cx="10" cy="10" r="1.7" fill="#E3A341"/></svg>
        <h1 id="gameRunningTitle"><%- lang('gameRunning.title') %></h1>
        <p class="gameRunningText"><%- lang('gameRunning.text') %></p>
    </section>
    <%- include('overlay') %>
    <div id="loadingContainer">
        <svg class="emblem emblemPulse" width="56" height="56" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9" fill="none" stroke="currentColor" stroke-opacity="0.7" stroke-width="0.8"/><circle cx="10" cy="10" r="5.2" fill="none" stroke="currentColor" stroke-opacity="0.7" stroke-width="0.8"/><circle cx="10" cy="10" r="1.7" fill="#E3A341"/></svg>
    </div>
</body>
</html>
